# Copy this file to .env, then configure one server-side provider key locally.
OPENROUTER_API_KEY=
# FIRMSIGHT_9ROUTER_API_KEY=
FIRMSIGHT_AI_PROVIDER=openrouter
FIRMSIGHT_AI_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# For local 9router use:
# FIRMSIGHT_AI_PROVIDER=9router
# FIRMSIGHT_AI_ENDPOINT=http://127.0.0.1:20128/v1/chat/completions
# Optional: override the HTTP User-Agent for an OpenAI-compatible gateway.
# FIRMSIGHT_AI_USER_AGENT=FirmSight/0.1
# Optional fresh-database fallback for all roles (Settings values take precedence).
# FIRMSIGHT_AI_MAX_TOKENS=2000
# Optional fresh-database structured-review role budgets; accepted values are
# Investigator 1200/1600/2000/2400/3200 and Verifier 800/1200/1600/2000.
# Select PROVIDER_DEFAULT for either role from the persisted Settings UI.
# FIRMSIGHT_AI_INVESTIGATOR_MAX_TOKENS=2000
# FIRMSIGHT_AI_VERIFIER_MAX_TOKENS=1200
# Optional shared concurrency for independent review units (1, 2, or 3).
# FIRMSIGHT_REVIEW_PARALLEL_REQUESTS=2
# Optional: choose provider structured-output behavior. PROMPT_ONLY is the
# compatibility default; JSON_OBJECT/JSON_SCHEMA require gateway support.
# FIRMSIGHT_AI_STRUCTURED_OUTPUT_MODE=PROMPT_ONLY
# Optional provider reasoning hint; reasoning and final output share the limit.
# FIRMSIGHT_AI_REASONING_EFFORT=UNSPECIFIED
FIRMSIGHT_MODEL_INVESTIGATOR=z-ai/glm-5.3-flash
FIRMSIGHT_MODEL_VERIFIER=z-ai/glm-5.3-flash
FIRMSIGHT_MODEL_CHAT=z-ai/glm-5.3-flash
FIRMSIGHT_MODEL_YAML_GENERATOR=z-ai/glm-5.3-flash

# Local directories that FirmSight may inspect. Set this to a narrow parent
# folder containing your firmware projects, then restart the backend.
FIRMSIGHT_IMPORT_ROOT=/path/to/firmware-workspace
